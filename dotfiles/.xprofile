# UNDERGROUND // xprofile — read by the display manager for X sessions (i3)
# nothing exports these on X by itself, so they live here
export PATH="$HOME/.local/bin:$PATH"

# toolkit / theme: Adwaita-dark + Papirus-Dark + Bibata (see ~/.config/gtk-3.0/settings.ini)
export QT_QPA_PLATFORM=xcb
export QT_QPA_PLATFORMTHEME=qt6ct
export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE=24
export GTK_THEME=Adwaita:dark

# load ~/.Xresources (cursor + font); needs xorg-xrdb
command -v xrdb >/dev/null && xrdb -merge "$HOME/.Xresources"

# NVIDIA: allow G-Sync/VRR for fullscreen games (picom unredirects fullscreen windows)
export __GL_GSYNC_ALLOWED=1
export __GL_VRR_ALLOWED=1
