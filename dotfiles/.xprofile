# UNDERGROUND // xprofile — lido pelo SDDM em sessões X (i3)
# no X ninguém exporta essas variáveis sozinho, então é aqui
export PATH="$HOME/.local/bin:$PATH"

# toolkit / tema: Adwaita-dark + Papirus-Dark + Bibata (veja ~/.config/gtk-3.0/settings.ini)
export QT_QPA_PLATFORM=xcb
export QT_QPA_PLATFORMTHEME=qt6ct
export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE=24
export GTK_THEME=Adwaita:dark

# carrega ~/.Xresources (cursor + fonte); precisa do xorg-xrdb
command -v xrdb >/dev/null && xrdb -merge "$HOME/.Xresources"

# NVIDIA: G-Sync/VRR liberado pra jogos em tela cheia (o picom desliga sozinho em fullscreen)
export __GL_GSYNC_ALLOWED=1
export __GL_VRR_ALLOWED=1
