// ═══════════════════════════════════════════════════════════════
//  UNDERGROUND // fastfetch — layout em árvore
//  o logo é sorteado pelo ~/.config/fastfetch/logo.sh (linus / anon / fsociety)
//  backup do antigo (logo do arch): config.jsonc.bak-arch
// ═══════════════════════════════════════════════════════════════
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "chafa",
    "source": "~/.config/fastfetch/logos/anon.png",
    "width": 36,
    "height": 18,
    "padding": { "top": 1, "left": 2, "right": 4 },
    "chafa": { "symbols": "block+border+space" }
  },
  "display": {
    "separator": " → ",
    "color": { "keys": "blue", "output": "white", "separator": "90" },
    "key": { "width": 13 },
    "size": { "binaryPrefix": "jedec", "ndigits": 1 }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}",
      "color": { "user": "red", "at": "90", "host": "red" } },
    { "type": "custom", "format": "\u001b[90m───────────────\u001b[0m" },

    { "type": "os",       "key": "OS",        "keyColor": "cyan", "format": "{name} {arch}" },
    { "type": "kernel",   "key": "├ kernel",  "format": "{release}" },
    { "type": "uptime",   "key": "├ uptime" },
    { "type": "packages", "key": "└ pkgs",    "format": "{all} (pacman)" },
    "break",
    { "type": "board",    "key": "PC",        "keyColor": "cyan", "format": "{name}" },
    { "type": "cpu",      "key": "├ cpu",     "format": "{name} ({cores-logical}) @ {freq-max}" },
    { "type": "gpu",      "key": "├ gpu",     "format": "{name}" },
    { "type": "memory",   "key": "├ mem",     "format": "{used} / {total} ({percentage})" },
    { "type": "disk",     "key": "├ disk",    "folders": "/", "format": "{size-used} / {size-total}" },
    { "type": "display",  "key": "└ display", "format": "{width}x{height} @ {refresh-rate}Hz" },
    "break",
    { "type": "wm",       "key": "WM",        "keyColor": "cyan", "format": "{pretty-name}" },
    { "type": "command",  "key": "├ bar",     "text": "if pgrep -x i3blocks >/dev/null; then echo i3blocks; elif pgrep -x waybar >/dev/null; then echo waybar; else echo i3bar; fi" },
    { "type": "command",  "key": "└ comp",    "text": "pgrep -x picom >/dev/null && echo picom || echo none" },
    "break",
    { "type": "terminal", "key": "TTY",       "keyColor": "cyan", "format": "{pretty-name}" },
    { "type": "shell",    "key": "└ shell",   "format": "{pretty-name} {version}" },
    "break",
    { "type": "custom",   "format": "\u001b[34m[anon]\u001b[90m expect us.\u001b[0m" }
  ]
}
