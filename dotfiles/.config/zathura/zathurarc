# UNDERGROUND // zathura
set font "CaskaydiaCove Nerd Font Mono 10"
set selection-clipboard clipboard
set adjust-open width
set guioptions ""
set recolor true
set recolor-keephue true
set recolor-lightcolor "#101014"
set recolor-darkcolor  "#d4d4dc"
set default-bg "#101014"
set default-fg "#d4d4dc"
set statusbar-bg "#17181f"
set statusbar-fg "#6b6c78"
set inputbar-bg "#101014"
set inputbar-fg "#22c7d8"
set notification-bg "#101014"
set notification-fg "#1793d1"
set notification-error-bg "#e06c75"
set notification-error-fg "#101014"
set highlight-color "rgba(23,147,209,0.4)"
set highlight-active-color "rgba(34,199,216,0.6)"
set completion-bg "#17181f"
set completion-fg "#6b6c78"
set completion-highlight-bg "#1793d1"
set completion-highlight-fg "#101014"
set index-bg "#101014"
set index-fg "#d4d4dc"
set index-active-bg "#1793d1"
set index-active-fg "#101014"
# i = invert colors (dark mode on/off)
map i recolor
map r reload
