#!/usr/bin/env bash
# now playing (playerctl). click: play/pause · right click: next · scroll: player volume
case $BLOCK_BUTTON in
  1) playerctl play-pause ;;
  3) playerctl next ;;
  4) playerctl volume 0.05+ ;;
  5) playerctl volume 0.05- ;;
esac
st=$(playerctl status 2>/dev/null) || exit 0
t=$(playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null)
[[ -z $t || $t == " - " ]] && exit 0
(( ${#t} > 45 )) && t="${t:0:44}…"
icon="󰏤"; [[ $st == Playing ]] && icon="󰎈"
t=${t//&/&amp;}; t=${t//</&lt;}
echo "$icon $t"
