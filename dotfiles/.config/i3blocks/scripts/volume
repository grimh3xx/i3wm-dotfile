#!/usr/bin/env bash
# click: mute · right click: pavucontrol · scroll: ±5. updates instantly via signal 10
case $BLOCK_BUTTON in
  1) pamixer -t ;;
  3) (pavucontrol >/dev/null 2>&1 &) ;;
  4) pamixer -i 5 ;;
  5) pamixer -d 5 ;;
esac
v=$(pamixer --get-volume 2>/dev/null) || exit 0
if [[ $(pamixer --get-mute) == true ]]; then
  echo "<span color='#d8a657'>󰖁 mute</span>"
else
  echo "<span color='#22c7d8'>󰕾</span> ${v}%"
fi
