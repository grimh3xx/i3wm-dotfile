# UNDERGROUND // i3blocks
separator=true
separator_block_width=24
markup=pango
color=#d4d4dc

[anon]
command=~/.config/i3blocks/scripts/anon
interval=30

[music]
command=~/.config/i3blocks/scripts/music
interval=3

[net]
command=~/.config/i3blocks/scripts/net
interval=10

[disk]
command=~/.config/i3blocks/scripts/disk
interval=60

[mem]
command=~/.config/i3blocks/scripts/mem
interval=5

[cpu]
command=~/.config/i3blocks/scripts/cpu
interval=persist

[gpu]
command=~/.config/i3blocks/scripts/gpu
interval=5

[volume]
command=~/.config/i3blocks/scripts/volume
interval=once
signal=10

[caffeine]
command=~/.config/i3blocks/scripts/caffeine
interval=once

[mic]
command=~/.config/i3blocks/scripts/mic
interval=10
signal=11

[locks]
command=~/.config/i3blocks/scripts/locks
interval=5
signal=12
separator=false
separator_block_width=8

[clock]
command=~/.config/i3blocks/scripts/clock
interval=10
