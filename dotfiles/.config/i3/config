# ═══════════════════════════════════════════════════════════════
#  UNDERGROUND // i3
#  paleta = kitty underground.conf · bg #101014 · arch #1793d1 · cyan #22c7d8
#  reload: Super+Shift+c   restart: Super+Shift+r   backup: config.bak
# ═══════════════════════════════════════════════════════════════

# mod = Alt (Mod1). pra voltar pro Super: Mod4
set $mod Mod1
set $term st
font pango:CaskaydiaCove Nerd Font 10

# ── paleta ─────────────────────────────────────────────────────
set $bg      #101014
set $bg2     #17181f
set $line    #26272f
set $dim     #6b6c78
set $fg      #d4d4dc
set $accent  #1793d1
set $cyan    #22c7d8
set $red     #e06c75

# ── autostart ──────────────────────────────────────────────────
exec_always --no-startup-id ~/.config/i3/scripts/monitor.sh
exec --no-startup-id setxkbmap us
exec --no-startup-id xset r rate 250 40
exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/.config/i3/scripts/lock.sh -n
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id dunst -config ~/.config/dunst-i3/dunstrc
# apps do autostart XDG (blueman, nm-applet, Discord/Steam se marcar "abrir ao iniciar"...)
# o picom do autostart está desligado em ~/.config/autostart/picom.desktop (usamos o nosso)
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id greenclip daemon
exec --no-startup-id redshift -c ~/.config/redshift/redshift.conf
exec --no-startup-id udiskie --smart-tray --notify
# tela: escurece/trava aos 8 min parado (xss-lock chama o lock.sh), desliga o monitor aos 10
exec --no-startup-id xset s 480 480 dpms 600 600 600
exec --no-startup-id picom --config ~/.config/picom-i3/picom.conf -b
# wallpaper: ~/.config/i3/wallpaper (symlink, troca com Alt+Shift+w)
exec_always --no-startup-id feh --no-fehbg --bg-fill ~/.config/i3/wallpaper

# ── visual ─────────────────────────────────────────────────────
# borda fina, sem título, gaps pequenos — some quando só tem 1 janela
default_border pixel 2
default_floating_border pixel 2
for_window [class=".*"] border pixel 2
gaps inner 6
gaps outer 0
smart_gaps on
smart_borders on
focus_follows_mouse no
workspace_auto_back_and_forth yes
title_align center

#                       borda    fundo    texto  indicador  borda_filho
client.focused          $accent  $accent  $bg    $cyan      $accent
client.focused_inactive $line    $bg2     $dim   $line      $line
client.unfocused        $line    $bg      $dim   $line      $line
client.urgent           $red     $red     $bg    $red       $red
client.background       $bg

# ── básico ─────────────────────────────────────────────────────
floating_modifier $mod
tiling_drag modifier titlebar
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec kitty
bindsym $mod+Ctrl+Return exec $term -e sh -c 'tmux new -A -s main'
bindsym $mod+q kill
# busca: apps + janelas abertas + comandos, tudo junto
bindsym $mod+d exec --no-startup-id ~/.config/i3/scripts/launcher.sh
# web (g/aw/aur/yt/gh/w + termo) · calculadora · emoji · clipboard
bindsym $mod+o exec --no-startup-id ~/.config/i3/scripts/websearch.sh
bindsym $mod+equal exec --no-startup-id ~/.config/i3/scripts/calc.sh
bindsym $mod+period exec --no-startup-id rofimoji --action copy --selector-args="-theme ~/.config/rofi/underground.rasi"
bindsym $mod+v exec --no-startup-id ~/.config/i3/scripts/clipboard.sh
bindsym $mod+Shift+v exec --no-startup-id ~/.config/i3/scripts/clipboard.sh clear
bindsym $mod+Shift+w exec --no-startup-id ~/.config/i3/scripts/wallpaper.sh
bindsym $mod+Shift+d exec --no-startup-id dmenu_run -p '>' -fn 'CaskaydiaCove Nerd Font-10' -nb '#101014' -nf '#6b6c78' -sb '#1793d1' -sf '#101014'
bindsym $mod+Escape exec --no-startup-id ~/.config/i3/scripts/lock.sh

# ── dropdowns (scratchpad): aperta = mostra, aperta de novo = esconde ──
# 1ª vez abre no st; depois só alterna. tamanhos pensados pro 3440x1440
for_window [instance="^(claude|btop|notes|files|music|viz|irc|news)$"] floating enable, move scratchpad
for_window [instance="^claude$"] resize set 1600 1000, move position center, scratchpad show
for_window [instance="^btop$"]   resize set 1700 950,  move position center, scratchpad show
for_window [instance="^notes$"]  resize set 1100 800,  move position center, scratchpad show
for_window [instance="^files$"]  resize set 1500 850,  move position center, scratchpad show
for_window [instance="^music$"]  resize set 1400 800,  move position center, scratchpad show
for_window [instance="^viz$"]    resize set 3200 300,  move position 120 px 1100 px, scratchpad show
for_window [instance="^irc$"]    resize set 1600 1000, move position center, scratchpad show
for_window [instance="^news$"]   resize set 1500 950,  move position center, scratchpad show
set $drop exec --no-startup-id ~/.config/i3/scripts/scratch.sh
bindsym $mod+c       $drop claude claude
bindsym $mod+t       $drop btop btop
bindsym $mod+n       $drop notes nano ~/notes.md
bindsym $mod+e       $drop files lf
bindsym $mod+m       $drop music ncspot
bindsym $mod+Shift+m $drop viz cava
bindsym $mod+i       $drop irc weechat
bindsym $mod+Shift+n $drop news newsboat
# claude num tile normal
bindsym $mod+Shift+c exec $term -e claude

# cola de atalhos: lista tudo no rofi, Enter executa
bindsym $mod+slash exec --no-startup-id ~/.config/i3/scripts/keys.sh

# foco (vim + setas)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# mover janela
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# layout
bindsym $mod+b split h
bindsym $mod+Shift+b split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+x layout toggle split
bindsym $mod+space floating toggle
bindsym $mod+Shift+space focus mode_toggle
bindsym $mod+a focus parent

# gaps na hora: Super+g liga/desliga
bindsym $mod+g gaps inner current toggle 6

# scratchpad genérico
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# ── workspaces ─────────────────────────────────────────────────
set $ws1 "1:一"
set $ws2 "2:二"
set $ws3 "3:三"
set $ws4 "4:四"
set $ws5 "5:五"
set $ws6 "6:六"
set $ws7 "7:七"
set $ws8 "8:八"
set $ws9 "9:九"
set $ws10 "10:十"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+Tab workspace back_and_forth
# primeiro workspace vazio (com Ctrl leva a janela junto)
bindsym $mod+Shift+Tab exec --no-startup-id ~/.config/i3/scripts/empty_workspace.sh
bindsym $mod+Ctrl+Tab exec --no-startup-id ~/.config/i3/scripts/empty_workspace.sh move

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ── mídia / volume / print ─────────────────────────────────────
set $vol pkill -RTMIN+10 i3blocks
bindsym XF86AudioRaiseVolume exec --no-startup-id pamixer -i 5 && $vol
bindsym XF86AudioLowerVolume exec --no-startup-id pamixer -d 5 && $vol
bindsym XF86AudioMute exec --no-startup-id pamixer -t && $vol
# microfone: tecla de mic do teclado ou Alt+Shift+a · Alt+p escolhe a saída de áudio
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && pkill -RTMIN+11 i3blocks
bindsym $mod+Shift+a exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && pkill -RTMIN+11 i3blocks
bindsym $mod+p exec --no-startup-id ~/.config/i3/scripts/audio_menu.sh
# caps/num na barra atualizam na hora
bindsym --release Caps_Lock exec --no-startup-id pkill -RTMIN+12 i3blocks
bindsym --release Num_Lock  exec --no-startup-id pkill -RTMIN+12 i3blocks
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# Print = tela inteira | Shift+Print = seleção (salva e copia)
bindsym Print exec --no-startup-id ~/.config/i3/scripts/shot.sh full
bindsym $mod+Shift+s exec --no-startup-id flameshot gui
bindsym Shift+Print exec --no-startup-id ~/.config/i3/scripts/shot.sh area

# ── cada app no seu canto ──────────────────────────────────────
# 1 term · 2 web · 3 chat · 4 arquivos · 5 jogos · 6 spotify
assign [class="(?i)^(firefox|brave-browser|chromium|zen)$"] number $ws2
assign [class="(?i)^(discord|vesktop|telegramdesktop)$"]  number $ws3
assign [class="(?i)^(thunar|dolphin)$"]                     number $ws4
assign [class="(?i)^(steam|lutris|heroic)$"]                number $ws5
for_window [class="(?i)^spotify$"] move container to workspace number $ws6
for_window [class="(?i)^steam_app_"] move container to workspace number $ws5

# ── regras de janela ───────────────────────────────────────────
for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="nm-connection-editor"] floating enable
for_window [class="(?i)^(mpv|nsxiv)$"] floating enable, resize set 1600 900, move position center

# ── sessão (Alt+Shift+e → menu de energia no rofi) ──────────────────────────────
bindsym $mod+Shift+x reload
bindsym $mod+Shift+r restart

bindsym $mod+Shift+e exec --no-startup-id ~/.config/i3/scripts/powermenu.sh

# ── resize (Super+r, hjkl/setas, Esc sai) ──────────────────────
mode "resize" {
    bindsym h resize shrink width 10 px or 5 ppt
    bindsym j resize grow height 10 px or 5 ppt
    bindsym k resize shrink height 10 px or 5 ppt
    bindsym l resize grow width 10 px or 5 ppt
    bindsym Left resize shrink width 10 px or 5 ppt
    bindsym Down resize grow height 10 px or 5 ppt
    bindsym Up resize shrink height 10 px or 5 ppt
    bindsym Right resize grow width 10 px or 5 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ── barra ──────────────────────────────────────────────────────
bar {
    # i3blocks se tiver instalado; senão cai no i3status
    status_command sh -c 'command -v i3blocks >/dev/null && exec i3blocks -c ~/.config/i3blocks/config || exec i3status -c ~/.config/i3status/config'
    position top
    height 24
    tray_output primary
    tray_padding 2
    workspace_min_width 28
    strip_workspace_numbers yes
    separator_symbol " // "
    font pango:CaskaydiaCove Nerd Font 10
    colors {
        background $bg
        statusline $dim
        separator  $line
        #                  borda    fundo    texto
        focused_workspace  $accent  $accent  $bg
        active_workspace   $line    $bg2     $fg
        inactive_workspace $bg      $bg      $dim
        urgent_workspace   $red     $red     $bg
        binding_mode       $cyan    $cyan    $bg
    }
}
