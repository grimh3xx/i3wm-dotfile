#!/usr/bin/env bash
# called by st (Ctrl+Shift+U): reads the screen text on stdin, lists links in rofi and opens the one you pick
url=$(grep -aEo '(https?|ftp)://[^][[:space:]<>"'"'"'()]+|www\.[^][[:space:]<>"'"'"'()]+' | tac | awk '!s[$0]++' \
  | rofi -dmenu -i -p url -theme ~/.config/rofi/underground.rasi -theme-str 'entry{placeholder:"open a link_";}')
[[ -n $url ]] && setsid -f xdg-open "$url" >/dev/null 2>&1
